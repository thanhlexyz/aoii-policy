% Preamble for slide.tex. Kept separate from paper.sty, which targets the
% ieeetmlcn class and pulls in commands beamer has no definition for.

% Font setting
\usepackage{iftex}
\ifPDFTeX
  \usepackage[T1]{fontenc}
  \usepackage[utf8]{inputenc}
  \usepackage{lmodern}
\else
  \usepackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX}
  \setsansfont{Carlito}[
    UprightFont    = *-regular,
    BoldFont       = *-bold,
    ItalicFont     = *-italic,
    BoldItalicFont = *-bolditalic,
  ]
  \renewcommand{\familydefault}{\sfdefault}
\fi
% Navigation symbols off (theme may also set this)
\setbeamertemplate{navigation symbols}{}
% Citation (biber), same style and sorting as paper.sty
\usepackage[backend=biber,style=ieee,sorting=none]{biblatex}
\addbibresource{paper.bib}
% Math
\usepackage{amsmath,amssymb,amsfonts,bbm}
\usepackage{etoolbox}
% Figures
\usepackage{graphicx}
\usepackage{subcaption}
% Drawing tikz. Same library set as paper.sty, so figure/*.tex loads unchanged.
\usepackage{tikz}
\usetikzlibrary{arrows, arrows.meta, automata, positioning, shapes.geometric, shapes.symbols, fit, backgrounds, calc}
% Table
\usepackage{booktabs}
\usepackage{multirow}
\usepackage{array}
% Animated figure sequences (the motivation and vhct frame flips)
\usepackage{animate}

% Acronyms. The deck spells them out on first use; the paper, at six pages,
% does not carry the package.
\usepackage[acronym, nowarn]{glossaries}
\makeglossaries
\loadglsentries{section/glossary}

% Other
\usepackage{float}
\usepackage{url}

% Tool name, mirroring paper.sty
\newcommand{\tool}{\textsc{Tool}}
\newcommand{\djscc}{DeepJSCC}
\newcommand{\ibp}{\textsc{Ibp}}
\newcommand{\acrown}{$\alpha$-\textsc{Crown}}
\newcommand{\crown}{\textsc{Crown}}
\newcommand{\gloro}{\textsc{GloRo}}
\newcommand{\naive}{\textsc{Naive}}
\newcommand{\deeppoly}{\textsc{DeepPoly}}
\newcommand{\pyrat}{\textsc{PyRAT}}
\newcommand{\autolirpa}{\texttt{auto\_LiRPA}}

% Architecture / activation shorthands
\newcommand{\relu}{\textsc{ReLU}}
\newcommand{\prelu}{\textsc{PReLU}}
\newcommand{\convtranspose}{\textsc{ConvTranspose2d}}
\newcommand{\upsampleconv}{\textsc{Upsample+Conv2d}}

% Comments, same authors and colors as paper.sty
\newtoggle{usecomment}
\settoggle{usecomment}{false}
\newcommand{\tl}[1]{\iftoggle{usecomment}{{\color{blue}{[TL]: #1}}}{}}
\newcommand{\hd}[1]{\iftoggle{usecomment}{{\color{red}{[HD]: #1}}}{}}
\newcommand{\tvn}[1]{\iftoggle{usecomment}{{\color{magenta}{[TVN]: #1}}}{}}
\newcommand{\tm}[1]{\iftoggle{usecomment}{{\color{green}{[TM]: #1}}}{}}

% Helpers
\newcommand{\greenalert}[1]{\textcolor{green!60!black}{#1}}
\newcommand{\eg}{e.g.\@}
\newcommand{\ie}{i.e.\@}

% Beamer captions: numbered captions read oddly on a slide.
\setbeamertemplate{caption}{\raggedright\insertcaption\par}
\setbeamerfont{caption}{size=\scriptsize}
