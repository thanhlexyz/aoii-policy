% Beamer theme approximating template.pptx (NICT / Office-style master).
% Compile with XeLaTeX or LuaLaTeX (fontspec). For pdfLaTeX use the [legacyfonts] option.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemenict}[2026/04/14 NICT slide theme]

\newif\ifnict@legacyfonts
\nict@legacyfontsfalse
\DeclareOption{legacyfonts}{\nict@legacyfontstrue}
\ProcessOptions\relax

\mode<presentation>{

\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc}

% Header strip image (same asset as pptx slide master). Override in the preamble if needed:
% \renewcommand{\nictheaderimage}{other-banner.jpg}
\newcommand{\nictheaderimage}{static/header.jpeg}

% --- Colors from template.pptx (theme1 + slideMaster1) ---
\definecolor{nictblue}{HTML}{004EA2} % footer gradient start, header bar
\definecolor{nictcyan}{HTML}{0081CC}      % footer gradient mid
\definecolor{nictaccent5}{HTML}{5B9BD5}   % Office accent5 (title slide title base)
\definecolor{nicttitle}{HTML}{6EB4E4}     % lighter blue for title slide (accent5 + lum tweak)
\definecolor{nictbullet}{HTML}{FFC000}    % body bullet / level-1 marker color
\definecolor{nictdk2}{HTML}{44546A}       % tx2 / secondary text
\definecolor{nictfootnum}{HTML}{595959}   % slide number (~75% tint of black)

\newcommand{\nictcopyright}{%
  % Copyright~\copyright~\the\year\ National Institute of Information and Communications Technology. All Rights Reserved}

}

\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{structure}{fg=nictblue}
\setbeamercolor{alerted text}{fg=red!80!black}
\setbeamercolor{frametitle}{fg=white}
\setbeamercolor{title}{fg=nicttitle}
\setbeamercolor{subtitle}{fg=black}
\setbeamercolor{author}{fg=black}
\setbeamercolor{date}{fg=black}
\setbeamercolor{institute}{fg=nictdk2}
\setbeamercolor{section title}{fg=nicttitle}
\setbeamercolor{footline}{fg=white}
\setbeamercolor{itemize item}{fg=nictbullet}
\setbeamercolor{itemize subitem}{fg=nictbullet}
\setbeamercolor{itemize subsubitem}{fg=nictbullet}
\setbeamercolor{enumerate item}{fg=nictblue}

\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{institute}{size=\normalsize}
\setbeamerfont{section title}{size=\LARGE,series=\bfseries}

\setbeamersize{text margin left=0.85cm,text margin right=0.85cm}

\useinnertheme{default}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{itemize subitem}[triangle]

\newlength{\nictheaderh}
\setlength{\nictheaderh}{0.095\paperheight}
\newlength{\nictfooterh}
\setlength{\nictfooterh}{0.036\paperheight}

\setbeamertemplate{background}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west, inner sep=0] at (current page.north west)
      {\includegraphics[width=\paperwidth,height=\the\nictheaderh,keepaspectratio=false]{\nictheaderimage}};
  \end{tikzpicture}%
}

\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[
    wd=\paperwidth,
    sep=0pt,
    leftskip=1em,
    rightskip=1em plus 1fil,
    ignorebg]{frametitle}%
    \vbox to \nictheaderh{%
      \vfil
      \usebeamerfont{frametitle}%
      \usebeamercolor[fg]{frametitle}%
      \insertframetitle\par
      \vfil}%
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{tikzpicture}
      \shade[left color=nictblue, right color=white, middle color=nictcyan]
        (0,0) rectangle (\paperwidth,\the\nictfooterh);
      \node[anchor=west, text=white, font=\fontsize{6.5}{8}\selectfont]
        at ({0.015*\paperwidth},{0.5*\the\nictfooterh})
        {\parbox{0.72\paperwidth}{\raggedright\nictcopyright}};
      \node[anchor=east, text=nictfootnum, font=\fontsize{7}{8}\selectfont]
        at ({0.985*\paperwidth},{0.5*\the\nictfooterh})
        {\insertframenumber};
    \end{tikzpicture}%
  }%
  \vskip0pt%
}

\setbeamertemplate{title page}{%
  \vspace*{2em}
  \begin{center}
    \begin{beamercolorbox}[sep=0pt,center]{title}
      \usebeamerfont{title}%
      \textcolor{nicttitle}{\inserttitle}%
    \end{beamercolorbox}
    \medskip
    \begin{beamercolorbox}[sep=0pt,center]{subtitle}
      \usebeamerfont{subtitle}\insertsubtitle
    \end{beamercolorbox}
    \vfill
    \begin{beamercolorbox}[sep=0pt,center]{author}
      \usebeamerfont{author}\insertauthor
    \end{beamercolorbox}
    \smallskip
    \begin{beamercolorbox}[sep=0pt,center]{institute}
      \usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute
    \end{beamercolorbox}
    \smallskip
    \begin{beamercolorbox}[sep=0pt,center]{date}
      \usebeamerfont{date}\insertdate
    \end{beamercolorbox}
  \end{center}
  \vspace*{1em}
}

\setbeamertemplate{section page}{
  \vfill
  \begingroup
  \centering
  \begin{beamercolorbox}[sep=0.75em,center,rounded=true,shadow]{section title}
    \usebeamerfont{section title}\insertsectionhead\par
  \end{beamercolorbox}
  \vfill
  \endgroup
}

} % presentation mode

\mode<all>
